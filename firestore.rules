rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    match /conferences/{confId} {
      allow read, write: if isSignedIn();
    }

    match /users/{userId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && request.auth.uid == userId;
    }

    match /attendances/{attendanceId} {
      allow read, write: if isSignedIn();
    }

    // Pings: metadata only. Clients can read their own sides (sender or
    // recipient) to power the Signals badge + direct lookups. All writes
    // go through the API (Admin SDK bypasses rules), so client writes
    // are blocked.
    match /pings/{pingId} {
      allow read: if isSignedIn() &&
        (request.auth.uid == resource.data.from_user_id ||
         request.auth.uid == resource.data.to_user_id);
      allow write: if false;
    }

    // Ping disclosures: only the sender (owner) can read. Recipients
    // receive the disclosure only via the API's /pings/mutual-contacts
    // endpoint, which runs with Admin privileges and returns the payload
    // only after a mutual ping exists.
    match /ping_contacts/{pingId} {
      allow read: if isSignedIn() && request.auth.uid == resource.data.owner_id;
      allow write: if false;
    }
  }
}
