rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    match /conferences/{confId} {
      // Conference catalog writes go through the API (Admin SDK bypasses
      // rules). Blocking client writes prevents any signed-in user from
      // mutating shared catalog data.
      allow read: if isSignedIn();
      allow write: if false;
    }

    // User docs hold sensitive fields (`email`, `saved_contacts`) that
    // must only ever leave the server as explicit ping disclosures.
    // Restrict client reads to self; peer profile reads go through the
    // API (`/users/:id*`), which strips these fields via toPublicUser.
    match /users/{userId} {
      allow read: if isSignedIn() && request.auth.uid == userId;
      allow write: if isSignedIn() && request.auth.uid == userId;
    }

    match /attendances/{attendanceId} {
      // Clients only need to subscribe to their OWN attendances; peers'
      // attendances flow through `/users/:id/attendances` (which gates
      // on hidden-user visibility). All writes go through the API
      // (Admin SDK). Restricting client reads to the requester's own
      // user_id prevents bypass of the visibility gate via direct SDK
      // reads.
      allow read: if isSignedIn() && resource.data.user_id == request.auth.uid;
      allow write: if false;
    }

    // Pings: metadata only. Recipient-side direct reads power the
    // Signals badge (useIncomingPingCount). Sender-side flows all go
    // through API endpoints (`/pings/incoming`, `/pings/outgoing`,
    // `/pings/mutual-contacts`), which intentionally hide
    // `rejected_at` from senders so a recipient's reject can fade
    // silently rather than notify the sender. Locking SDK reads to
    // recipients only preserves that boundary.
    //
    // Defense-in-depth: an earlier schema stored disclosures inline as
    // `pings/{id}.contacts`. The migration in
    // functions/scripts/migrate-ping-contacts.mjs splits them into
    // `ping_contacts/{id}` (owner-only). Until that migration runs in
    // production, recipients reading a stale ping doc could see the
    // disclosure pre-mutual. We block reads of any ping doc that still
    // carries the legacy field so a forgotten migration can't leak.
    match /pings/{pingId} {
      allow read: if isSignedIn() &&
        request.auth.uid == resource.data.to_user_id &&
        !('contacts' in resource.data);
      allow write: if false;
    }

    // Ping disclosures: only the sender (owner) can read. Recipients
    // receive the disclosure only via the API's /pings/mutual-contacts
    // endpoint, which runs with Admin privileges and returns the payload
    // only after a mutual ping exists.
    match /ping_contacts/{pingId} {
      allow read: if isSignedIn() && request.auth.uid == resource.data.owner_id;
      allow write: if false;
    }

    // Topic vote counters for /demo/topics. Counts are public (the
    // demo screen reads them on every viewer); writes are gated to
    // signed-in users. The companion /user_topic_likes doc enforces
    // one-vote-per-user on the client. The counter itself is best-effort
    // — could be tightened with a Cloud Function transaction later.
    match /topic_likes/{topicId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    // Per-user record of which topic ids this user has liked. Drives
    // the toggle UI and prevents double-counting on the client.
    match /user_topic_likes/{userId} {
      allow read, write: if isSignedIn() && request.auth.uid == userId;
    }

    // Live feed events. Written exclusively by Cloud Function triggers
    // (Admin SDK bypasses rules); clients only read. Payload is
    // deliberately public to all signed-in users — the third-party
    // "match" filter happens client-side against the viewer's profile.
    match /events/{eventId} {
      allow read: if isSignedIn();
      allow write: if false;
    }
  }
}
