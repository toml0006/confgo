{
  "name": "confgo-functions",
  "version": "0.1.0",
  "private": true,
  "main": "lib/index.js",
  "type": "commonjs",
  "engines": { "node": "22" },
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc -w",
