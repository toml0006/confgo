# Copy to web/.env.production and fill with real values from:
#   Firebase Console → Project Settings (gear icon) → Your apps → Web app
#   → "SDK setup and configuration" → Config
#
# These values aren't secret — Firebase web API keys are designed to be
# public in the client bundle. Security is enforced by Firestore rules +
# App Check, not by the apiKey itself. Safe to commit web/.env.production
# to the repo if you want (it's currently gitignored).
#
# vite.config.ts will REFUSE to produce a production bundle if these are
# unset or look like emulator/demo values — fail fast, don't ship a blank
# screen.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-real-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_APP_ID=1:1234567890:web:abcdef

VITE_USE_FIREBASE_EMULATORS=false
VITE_API_BASE_URL=/api

# Same Mapbox token works in dev and prod unless you've scoped URLs;
# set this to your real pk.* token.
VITE_MAPBOX_ACCESS_TOKEN=
